{
    "name": "country-iso-search",
    "version": "0.1.2",
    "description": "Resolve country names, codes, and aliases to canonical ISO 3166-1 alpha-3 codes.",
    "license": "MIT",
    "author": "Plotly, Inc.",
    "contributors": [
        "Cameron DeCoster <cameron.decoster@plot.ly>"
    ],
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "NOTICE"
    ],
    "keywords": [
        "iso",
        "iso-3166",
        "iso-3166-1",
        "country",
        "countries",
        "country-codes",
        "alpha-3",
        "alpha-2",
        "m49",
        "un-m49"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plotly/country-iso-search.git"
    },
    "bugs": {
        "url": "https://github.com/plotly/country-iso-search/issues"
    },
    "homepage": "https://github.com/plotly/country-iso-search#readme",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --clean",
        "format": "biome check --write .",
        "lint": "biome check .",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "alpinejs": "^3.15.12",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    }
}
